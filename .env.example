# Copy this file to .env, then replace passwords with private local values.
# Do NOT commit .env. These example passwords are placeholders.

# PostgreSQL
POSTGRES_USER=grab_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=grab_lab
POSTGRES_PORT=5432

# Firebird (connect as SYSDBA for the initial setup)
FIREBIRD_ROOT_PASSWORD=change_this_firebird_password
FIREBIRD_DATABASE=grab_lab.fdb
FIREBIRD_PORT=3050
